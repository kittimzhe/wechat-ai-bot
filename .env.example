# ===== 企业微信配置（必填）=====
# 企业ID：企业微信后台 → 我的企业 → 企业信息 → 企业ID
WECOM_CORP_ID=

# 应用Secret：应用管理 → 你的自建应用 → Secret
WECOM_CORP_SECRET=

# 应用AgentId：同一个应用详情页里可以看到（一串数字）
WECOM_AGENT_ID=

# 接收人：成员账号（userid），多个用 | 分隔
# 建议正式使用时填写明确 userid，不要无意间发给全部成员
WECOM_TO_USER=

# ===== AI 模型配置（必填，OpenAI 兼容接口）=====
# DeepSeek（推荐）：https://platform.deepseek.com
#   AI_BASE_URL=https://api.deepseek.com/v1
#   AI_MODEL=deepseek-chat
# 智谱（免费起步）：https://open.bigmodel.cn
#   AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
#   AI_MODEL=glm-4-flash
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat

# ===== 可靠性与运行参数（可选）=====
AI_TIMEOUT_SECONDS=120
AI_MAX_RETRIES=3
AI_RETRY_BASE_DELAY=1
AI_RETRY_MAX_DELAY=8
AI_TEMPERATURE=0.8
AI_MAX_TOKENS=1024
TIMEZONE=Asia/Shanghai
LOG_LEVEL=INFO
LOG_FILE=bot.log
# 任务失败时是否给 WECOM_TO_USER 发送告警
ALERT_ON_FAILURE=true
